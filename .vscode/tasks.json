{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake -S \"${workspaceFolder}\" -B \"${workspaceFolder}/build/x64\" -G \"Visual Studio 17 2022\" -A x64",
            "problemMatcher": [],
            "detail": "Configure Visual Studio 2022 x64 build tree"
        },
        {
            "label": "CMake: build Debug",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build/x64\" --config Debug --target imtrakker",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "detail": "Build imtrakker (Debug)"
        },
        {
            "label": "CMake: build Release",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build/x64\" --config Release --target imtrakker",
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Build imtrakker (Release)"
        },
        {
            "label": "CMake: build RelWithDebInfo",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build/x64\" --config RelWithDebInfo --target imtrakker",
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Build imtrakker (RelWithDebInfo)"
        },
        {
            "label": "CMake: build MinSizeRel",
            "type": "shell",
            "command": "cmake --build \"${workspaceFolder}/build/x64\" --config MinSizeRel --target imtrakker",
            "group": "build",
            "problemMatcher": "$msCompile",
            "detail": "Build imtrakker (MinSizeRel)"
        }
    ]
}
